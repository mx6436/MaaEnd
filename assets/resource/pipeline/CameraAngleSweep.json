{
    "CameraAngleSweepMain": {
        "desc": "相机角度环扫任务入口",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CameraAngleSweepInit"
        ]
    },
    "CameraAngleSweepInit": {
        "desc": "重置采样计划并创建输出目录",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CameraAngleSweepInitAction",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CameraAngleSweepStep",
            "CameraAngleSweepEnd"
        ]
    },
    "CameraAngleSweepStep": {
        "desc": "读取第 k 步目标朝向并闭环转向",
        "recognition": "Custom",
        "custom_recognition": "CameraAngleSweepStepRecognition",
        "custom_recognition_param": {
            "mode": "remaining"
        },
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CameraAngleSweepTowardAction",
        "custom_action_param": {
            "rotation_threshold": 2
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CameraAngleSweepWaitBeforeMove"
        ]
    },
    "CameraAngleSweepWaitBeforeMove": {
        "desc": "转向完成后等待 1000ms 再前进",
        "pre_delay": 1000,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CameraAngleSweepMoveForward"
        ]
    },
    "CameraAngleSweepMoveForward": {
        "desc": "按 W 前进 200ms",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CharacterControllerForwardAxisAction",
        "custom_action_param": {
            "axis": 2
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CameraAngleSweepWaitBeforeSnapshot"
        ]
    },
    "CameraAngleSweepWaitBeforeSnapshot": {
        "desc": "移动完成后等待 500ms 再采样",
        "pre_delay": 500,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CameraAngleSweepSnapshot"
        ]
    },
    "CameraAngleSweepSnapshot": {
        "desc": "推断位置与角色朝向并保存标注截图",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CameraAngleSweepSnapshotAction",
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "CameraAngleSweepStep",
            "CameraAngleSweepEnd"
        ]
    },
    "CameraAngleSweepEnd": {
        "desc": "环扫全部完成",
        "recognition": "Custom",
        "custom_recognition": "CameraAngleSweepStepRecognition",
        "custom_recognition_param": {
            "mode": "done"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
